Form=="PT72" ~ "72 HR PATCH",
Form=="LOTN" ~ "LOTION",
Form=="CPCR" ~ "CAPSULE",
Form=="IV" ~ "IV",
Form=="PT24" ~ "24 HR PATCH",
Form=="PTWK" ~ "1 WEEK PATCH",
Form=="LOT" ~ "LOTION",
Form=="INHA" ~ "INHALER",
Form=="SHAM" ~ "SHAMPOO",
Form=="AEPB" ~ "AEROSOL",
Form=="LQCR" ~ "LIQUID",
Form=="ELIX" ~ "ELIXIR",
Form=="PAS" ~ "PASTE",
Form=="PDR" ~ "POWDER",
Form=="OIN" ~ "OINMENT",
Form=="SOLG" ~ "GEL",
Form=="CONC" ~ "CONCENTRATE",
Form=="ELI" ~ "ELIXIR",
