Form=="TBDP" ~ "TABLET",
Form=="CPEP" ~ "CAPSULE",
Form=="OINT" ~ "OINTMENT",
Form=="PTCH" ~ "PATCH",
Form=="CPSP" ~ "CAPSULE",
Form=="CP24" ~ "CAPSULE",
